{
  "name": "dxpr/dxpr_marketing_cms",
  "type": "drupal-profile",
  "description": "Marketing CMS demo site with DXPR Builder no-code page builder.",
  "homepage": "https://www.drupal.org/project/dxpr_marketing_cms",
  "license": "GPL-2.0-or-later",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
      {
          "type": "composer",
          "url": "https://packages.drupal.org/8"
      }
  ],
  "require": {
    "drupal/admin_toolbar": "^3",
    "drupal/advagg": "^6.0.0-alpha1",
    "drupal/block_classes": "^1.0",
    "drupal/bootstrap5": "^3 || ^4",
    "drupal/contact_block": "^2.0",
    "drupal/core": "^10.2.0",
    "drupal/default_content": "^2",
    "drupal/dxpr_builder": "^2.7.0-beta3 || ^3.0",
    "drupal/dxpr_theme_helper": "^1 || ^2 || ^3",
    "drupal/dxpr_theme": "^5 || ^6 || ^7 || ^8",
    "drupal/field_group": "^3.4",
    "drupal/gin_login": "^2",
    "drupal/gin_toolbar": "^1",
    "drupal/gin": "3.x-dev@dev",
    "drupal/media_library_form_element": "^2.1",
    "drupal/menu_link_attributes": "^1.3",
    "drupal/metatag": "^1",
    "drupal/minifyhtml": "^2.0",
    "drupal/moderation_dashboard": "^2.1",
    "drupal/pathauto": "^1.11",
    "drupal/redirect": "^1.8",
    "drupal/responsive_preview": "^2.0",
    "drupal/tmgmt": "^1.15",
    "drupal/tmgmt_google": "^1.1",
    "drupal/xmlsitemap": "^1.4"
  },
  "require-dev": {
      "drupal/core-dev": "^10",
      "drupal/devel": "^5.0.0",
      "drush/drush": "^12"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "tbachert/spi": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
